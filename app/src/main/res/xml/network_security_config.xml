<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ip-api.com's free tier only speaks plain HTTP; everything else stays HTTPS-only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ip-api.com</domain>
    </domain-config>
</network-security-config>
